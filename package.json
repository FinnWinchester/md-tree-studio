{
  "name": "tree-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Write a folder structure in Markdown and edit it as a file explorer, and the other way round.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.330",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
